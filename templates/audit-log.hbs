{{!
    The Character Tracker window: the player list at the start edge, and the selected player's log
    beside it under a context bar. Only one player's log is shown at a time.
}}
<div class="character-tracker-layout">

    <aside class="character-tracker-players">
        <div class="character-tracker-players__head">
            <h2 class="character-tracker-section-title">{{localize "character-tracker.ui.players"}}</h2>

            <div class="character-tracker-appearance">
                <button
                    type="button"
                    data-action="toggleAppearance"
                    class="character-tracker-btn character-tracker-btn--square character-tracker-btn--quiet character-tracker-appearance__button"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    aria-label="{{localize 'character-tracker.ui.appearance'}}"
                    data-tooltip="{{localize 'character-tracker.ui.appearanceTooltip'}}"
                    data-tooltip-class="{{tooltipClass}}"
                >
                    <i class="character-tracker-icon character-tracker-icon--row palette" aria-hidden="true"></i>
                </button>

                <div class="character-tracker-popover character-tracker-appearance__menu" role="menu" aria-label="{{localize 'character-tracker.ui.appearance'}}" hidden>
                    <div class="character-tracker-menu-head">{{localize "character-tracker.ui.accentColor"}}</div>
                    {{#each accents}}
                        <button
                            type="button"
                            role="menuitemradio"
                            data-action="setAccent"
                            data-accent="{{this.id}}"
                            class="character-tracker-menu-item"
                            aria-checked="{{#if this.isActive}}true{{else}}false{{/if}}"
                        >
                            <span class="character-tracker-tick{{#if this.isActive}} character-tracker-tick--on{{/if}}" aria-hidden="true"></span>
                            <span class="character-tracker-swatch character-tracker-swatch--{{this.id}}" aria-hidden="true"></span>
                            {{localize this.label}}
                        </button>
                    {{/each}}
                    <p class="character-tracker-menu-hint">{{localize "character-tracker.ui.appearanceHint"}}</p>
                </div>
            </div>
        </div>

        <nav class="character-tracker-players__list" aria-label="{{localize 'character-tracker.ui.players'}}">
            {{#each players}}
                <button
                    type="button"
                    data-action="selectPlayer"
                    data-user-id="{{this.id}}"
                    class="character-tracker-player{{#unless this.totalChanges}} character-tracker-player--empty{{/unless}}"
                    {{#if this.isSelected}}aria-current="true"{{/if}}
                >
                    <i class="character-tracker-icon character-tracker-icon--row person" aria-hidden="true"></i>
                    <span class="character-tracker-player__name">{{this.name}}</span>
                    {{#if this.isGM}}<span class="character-tracker-tag">{{localize "character-tracker.ui.gmTag"}}</span>{{/if}}
                    <span class="character-tracker-count">{{this.totalChanges}}</span>
                </button>
            {{/each}}
        </nav>

        <div class="character-tracker-players__foot">
            <button
                type="button"
                data-action="clearAll"
                class="character-tracker-btn character-tracker-btn--danger"
                data-tooltip="{{localize 'character-tracker.ui.clearAllHint'}}"
                data-tooltip-class="{{tooltipClass}}"
                {{#unless hasAnyLogs}}disabled{{/unless}}
            >
                <i class="character-tracker-icon character-tracker-icon--row delete" aria-hidden="true"></i>
                {{localize "character-tracker.ui.clearAll"}}
            </button>
        </div>
    </aside>

    <main class="character-tracker-main">
        {{#if currentPlayer}}
            {{#with currentPlayer}}
                <header class="character-tracker-context">
                    <div class="character-tracker-context__title">
                        <h1 class="character-tracker-panel-title">{{this.name}}</h1>
                        <span class="character-tracker-stats">{{this.statsText}}</span>
                    </div>

                    <div class="character-tracker-context__actions">
                        <button
                            type="button"
                            data-action="refreshLog"
                            class="character-tracker-btn character-tracker-btn--square"
                            aria-label="{{localize 'character-tracker.ui.refresh'}}"
                            data-tooltip="{{localize 'character-tracker.ui.refresh'}}"
                            data-tooltip-class="{{@root.tooltipClass}}"
                        >
                            <i class="character-tracker-icon character-tracker-icon--row refresh" aria-hidden="true"></i>
                        </button>
                        <button
                            type="button"
                            data-action="exportPlayer"
                            data-user-id="{{this.id}}"
                            class="character-tracker-btn character-tracker-btn--square"
                            aria-label="{{localize 'character-tracker.ui.exportTooltip'}}"
                            data-tooltip="{{localize 'character-tracker.ui.exportTooltip'}}"
                            data-tooltip-class="{{@root.tooltipClass}}"
                            {{#unless this.characters.length}}disabled{{/unless}}
                        >
                            <i class="character-tracker-icon character-tracker-icon--row download" aria-hidden="true"></i>
                        </button>
                        <button
                            type="button"
                            data-action="clearPlayer"
                            data-user-id="{{this.id}}"
                            class="character-tracker-btn character-tracker-btn--square character-tracker-btn--icon-danger"
                            aria-label="{{localize 'character-tracker.ui.clearTooltip'}}"
                            data-tooltip="{{localize 'character-tracker.ui.clearTooltip'}}"
                            data-tooltip-class="{{@root.tooltipClass}}"
                            {{#unless this.characters.length}}disabled{{/unless}}
                        >
                            <i class="character-tracker-icon character-tracker-icon--row delete" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="character-tracker-context__modes">
                        <div class="character-tracker-seg" role="radiogroup" aria-label="{{localize 'character-tracker.ui.viewLabel'}}">
                            <button
                                type="button"
                                role="radio"
                                data-action="setView"
                                data-view="chronological"
                                class="character-tracker-seg__option"
                                aria-checked="{{#if @root.isCategorical}}false{{else}}true{{/if}}"
                            >{{localize "character-tracker.ui.viewChronological"}}</button>
                            <button
                                type="button"
                                role="radio"
                                data-action="setView"
                                data-view="categorical"
                                class="character-tracker-seg__option"
                                aria-checked="{{#if @root.isCategorical}}true{{else}}false{{/if}}"
                            >{{localize "character-tracker.ui.viewCategorical"}}</button>
                        </div>

                        <button
                            type="button"
                            data-action="toggleReverted"
                            class="character-tracker-btn"
                            aria-pressed="{{#if @root.showReverted}}true{{else}}false{{/if}}"
                            data-tooltip="{{localize 'character-tracker.ui.expandRevertedTooltip'}}"
                            data-tooltip-class="{{@root.tooltipClass}}"
                        >
                            <i class="character-tracker-icon character-tracker-icon--row undo" aria-hidden="true"></i>
                            {{localize "character-tracker.ui.expandReverted"}}
                        </button>
                    </div>
                </header>

                <div class="character-tracker-log">
                    {{#each this.characters}}
                        <details class="character-tracker-card" data-section-key="{{this.key}}" {{#if this.open}}open{{/if}}>
                            <summary class="character-tracker-card__summary">
                                <i class="character-tracker-icon character-tracker-icon--row character-tracker-chevron chevron" aria-hidden="true"></i>
                                <i class="character-tracker-icon character-tracker-icon--row person" aria-hidden="true"></i>
                                <span class="character-tracker-card__name">{{this.name}}</span>
                                <span class="character-tracker-count">{{this.count}}</span>
                            </summary>

                            {{#if @root.isCategorical}}
                                <div class="character-tracker-card__body">
                                    {{#each this.groups}}
                                        <section class="character-tracker-group">
                                            <div class="character-tracker-group__title">
                                                <h3 class="character-tracker-section-title">{{localize this.title}}</h3>
                                                <span class="character-tracker-count">{{this.count}}</span>
                                            </div>
                                            {{#each this.entities}}
                                                {{#if this.isSingle}}
                                                    {{! An entity with one change shows that change directly, with no extra click }}
                                                    <ul class="character-tracker-log-list character-tracker-log-list--indent">
                                                        {{#each this.logs}}
                                                            {{> "modules/character-tracker/templates/log-entry.hbs"}}
                                                        {{/each}}
                                                    </ul>
                                                {{else}}
                                                    <details class="character-tracker-entity" data-section-key="{{this.key}}" {{#if this.open}}open{{/if}}>
                                                        <summary class="character-tracker-entity__summary">
                                                            <i class="character-tracker-icon character-tracker-icon--row character-tracker-chevron chevron" aria-hidden="true"></i>
                                                            <span class="character-tracker-entity__name">{{this.name}}</span>
                                                            <span class="character-tracker-count">{{this.count}}</span>
                                                        </summary>
                                                        <ul class="character-tracker-log-list character-tracker-log-list--nested">
                                                            {{#each this.logs}}
                                                                {{> "modules/character-tracker/templates/log-entry.hbs"}}
                                                            {{/each}}
                                                        </ul>
                                                    </details>
                                                {{/if}}
                                            {{/each}}
                                        </section>
                                    {{/each}}
                                </div>
                            {{else}}
                                <ul class="character-tracker-log-list character-tracker-card__body">
                                    {{#each this.logs}}
                                        {{> "modules/character-tracker/templates/log-entry.hbs"}}
                                    {{/each}}
                                </ul>
                            {{/if}}
                        </details>
                    {{else}}
                        <div class="character-tracker-card">
                            <p class="character-tracker-empty">{{localize "character-tracker.ui.noLogs"}}</p>
                        </div>
                    {{/each}}
                </div>
            {{/with}}
        {{else}}
            <div class="character-tracker-log">
                <div class="character-tracker-card">
                    <p class="character-tracker-empty">{{localize "character-tracker.ui.noPlayers"}}</p>
                </div>
            </div>
        {{/if}}
    </main>

</div>
